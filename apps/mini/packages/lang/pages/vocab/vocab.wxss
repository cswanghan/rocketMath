/* 背单词。整体沿用 Web 端 vocab.html 的信息层级: 进度条 → 筛选 → 模式 → 卡片 → 操作。
 * 进度条 / pill 行 / 反馈条 / 结算卡都在 app.wxss 的通用组件里。 */

.vocab {
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.gear {
  font-size: 40rpx;
  color: var(--muted);
  padding: 8rpx 12rpx;
}

/* ---- 筛选 ------------------------------------------------------------------ */

.filters {
  margin-bottom: 20rpx;
}

.mode-row {
  margin-bottom: 24rpx;
}

.topic-picker {
  background: var(--panel);
  border: 2rpx solid var(--line-strong);
  border-radius: 999rpx;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-soft);
  margin-bottom: 16rpx;
  display: inline-block;
}

/* ---- 单词卡 ---------------------------------------------------------------- */

.word-card {
  padding: 28rpx 32rpx 32rpx;
}

.card-top {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.status-text {
  font-size: 22rpx;
  color: var(--muted);
  margin-right: 16rpx;
}

.fav {
  font-size: 40rpx;
  line-height: 1;
  color: var(--muted);
  padding: 0 4rpx;
}

.fav-on {
  color: var(--accent2);
}

.prompt-label {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: var(--muted);
}

.headline {
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1.3;
  margin: 8rpx 0 6rpx;
  word-break: break-word;
}

.subline {
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 20rpx;
}

.tool-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.mini-card {
  background: var(--inset);
  border-radius: var(--radius-sm);
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}

.meaning-text {
  font-size: 32rpx;
  font-weight: 700;
}

/* 未揭晓时给一条"可点"的提示, 别做成纯模糊 —— 小屏上模糊反而像渲染坏了 */
.meaning-mask {
  font-size: 28rpx;
  color: var(--muted);
  font-weight: 600;
}

.example-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--text-soft);
}

.input-card {
  margin-top: 8rpx;
}

.answer-input {
  width: 100%;
  box-sizing: border-box;
  background: var(--panel);
  border: 2rpx solid var(--line-strong);
  border-radius: var(--radius-sm);
  padding: 24rpx 28rpx;
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
}

/* ---- 设置浮层 -------------------------------------------------------------- */

.settings-card {
  text-align: left;
}

.set-row {
  margin-bottom: 20rpx;
}

.set-label {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-soft);
  margin-bottom: 12rpx;
}

.set-line {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-top: 2rpx solid var(--line);
}

.set-line .set-label {
  margin-bottom: 0;
}

.switch {
  font-size: 24rpx;
  font-weight: 700;
  padding: 6rpx 24rpx;
  border-radius: 999rpx;
  background: var(--inset);
  color: var(--muted);
}

.switch-on {
  background: var(--p-mint-pill);
  color: var(--p-mint-ink);
}
