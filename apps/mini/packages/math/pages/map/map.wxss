/* 知识地图。等级条 + 上下册 + 单元 + 知识点卡。 */

.map-title {
  font-size: 46rpx;
}

/* ---- 等级条 -------------------------------------------------------------- */

.level-panel {
  background: var(--panel);
  border: 2rpx solid var(--line);
  border-radius: var(--radius-sm);
  padding: 22rpx 26rpx;
  margin-bottom: 32rpx;
  box-shadow: var(--shadow-soft);
}

.lv-badge {
  background: var(--p-blue-pill);
  color: var(--p-blue-ink);
  font-size: 26rpx;
  font-weight: 800;
  padding: 4rpx 20rpx;
  border-radius: 999rpx;
  margin-right: 16rpx;
}

.xp-text {
  font-size: 26rpx;
  font-weight: 700;
}

.xp-next {
  font-size: 22rpx;
  color: var(--muted);
}

.xp-bar {
  height: 14rpx;
  border-radius: 999rpx;
  background: var(--inset);
  overflow: hidden;
  margin-top: 14rpx;
}

.xp-fill {
  height: 100%;
  background: var(--btn-grad);
  border-radius: 999rpx;
}

/* ---- 分册 / 单元 --------------------------------------------------------- */

.term-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--title-ink);
  margin: 28rpx 0 12rpx;
}

.unit {
  margin-bottom: 24rpx;
}

.unit-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-soft);
  padding-left: 16rpx;
  border-left: 6rpx solid var(--p-peach-pill);
  margin-bottom: 14rpx;
}

/* ---- 知识点卡 ------------------------------------------------------------ */

.topic {
  background: var(--panel);
  border: 2rpx solid var(--line);
  border-radius: var(--radius-sm);
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-soft);
}

.topic--pressed {
  background: var(--active);
  transform: scale(0.99);
}

.topic-soon {
  background: var(--inset);
  box-shadow: none;
  opacity: 0.7;
}

.topic-head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.topic-name {
  font-size: 30rpx;
  font-weight: 700;
  flex: 1;
  min-width: 0;
}

/* 教学法标签 —— 一眼区分"口算"和"练习" */
.ped {
  font-size: 20rpx;
  font-weight: 700;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  margin-right: 14rpx;
  flex: none;
}

.ped-fluency { background: var(--p-blue-pill); color: var(--p-blue-ink); }
.ped-procedure { background: var(--p-peach-pill); color: var(--p-peach-ink); }
.ped-formula { background: var(--p-lavender-pill); color: var(--p-lavender-ink); }
.ped-concept { background: var(--p-mint-pill); color: var(--p-mint-ink); }
.ped-logic { background: var(--p-pink); color: var(--p-pink-ink); }
.ped-data { background: var(--p-teal); color: var(--p-teal-ink); }

.done-tag {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--good-ink);
  background: var(--p-mint);
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  margin-left: 10rpx;
}

.soon-tag {
  font-size: 22rpx;
  color: var(--muted);
  margin-left: 10rpx;
}

/* ---- 关卡格 (Rocket Chart) ------------------------------------------------ */

.chart {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.cell {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 10rpx;
  margin: 0 8rpx 8rpx 0;
  background: var(--inset);
  color: var(--muted);
}

.cell-done {
  background: var(--good);
  color: #fff;
}

.cell-current {
  background: var(--accent2);
  color: #fff;
  box-shadow: 0 0 0 4rpx rgba(243, 150, 10, 0.22);
}

/* ---- 底部行 -------------------------------------------------------------- */

.topic-foot {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.topic-meta {
  font-size: 24rpx;
  color: var(--muted);
}

.race-btn {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--accent-ink);
  background: var(--p-blue);
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
}
