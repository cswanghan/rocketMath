/* 知识点练习 (不计时)。题干 + 作答 + 底部反馈条。 */
@import '../../styles/drill.wxss';

/* ---- 三关进度条 ---------------------------------------------------------- */

.stage-bar {
  display: flex;
  margin-bottom: 24rpx;
}

.stage-seg {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  font-weight: 700;
  padding: 10rpx 0;
  background: var(--inset);
  color: var(--muted);
}

.stage-seg:first-child {
  border-radius: 999rpx 0 0 999rpx;
}

.stage-seg:last-child {
  border-radius: 0 999rpx 999rpx 0;
}

.stage-done {
  background: var(--p-mint);
  color: var(--p-mint-ink);
}

.stage-active {
  background: var(--accent2);
  color: #fff;
}

/* ---- 题干 ---------------------------------------------------------------- */

/* 竖式题: 靠空格对齐, 必须等宽字体 + 保留空白 */
.problem-prompt {
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  white-space: pre;
  font-size: 40rpx;
  line-height: 1.5;
  text-align: center;
  overflow-x: auto;
  margin: 20rpx 0;
}

.problem-text {
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.6;
  margin: 20rpx 0;
}

.problem-source {
  font-size: 20rpx;
  color: var(--muted);
  margin-bottom: 20rpx;
}

.wrong-hint {
  background: var(--p-peach);
  color: var(--p-peach-ink);
  font-size: 26rpx;
  border-radius: var(--radius-sm);
  padding: 16rpx 22rpx;
  margin-bottom: 20rpx;
}

/* ---- 作答 ---------------------------------------------------------------- */

.fill-input {
  width: 100%;
  box-sizing: border-box;
  background: var(--inset);
  border: 2rpx solid var(--line);
  border-radius: var(--radius-sm);
  padding: 24rpx 28rpx;
  font-size: 40rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 24rpx;
}

.fields {
  margin-bottom: 8rpx;
}

.field {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.field-label {
  width: 160rpx;
  font-size: 28rpx;
  font-weight: 700;
  flex: none;
}

.fill-input.small {
  flex: 1;
  font-size: 32rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 0;
  text-align: left;
}

.choices {
  margin-top: 8rpx;
}

.choice {
  background: var(--panel);
  border: 2rpx solid var(--line-strong);
  border-radius: var(--radius-sm);
  padding: 26rpx 28rpx;
  margin-bottom: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: var(--shadow-soft);
}

.choice--pressed {
  background: var(--p-blue);
  border-color: var(--accent);
  transform: scale(0.99);
}

/* ---- 底部反馈条 ---------------------------------------------------------- */

.feedback-bar {
  margin-top: auto;
  border-radius: var(--radius) var(--radius) 0 0;
  padding: 28rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  margin: 0 -28rpx -24rpx;
}

.fb-correct {
  background: var(--p-mint);
}

.fb-wrong {
  background: var(--p-peach);
}

.fb-title {
  font-size: 34rpx;
  font-weight: 800;
  margin-bottom: 6rpx;
}

.fb-correct .fb-title { color: var(--good-ink); }
.fb-wrong .fb-title { color: var(--p-peach-ink); }

.xp-pop {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--accent2);
  margin-bottom: 8rpx;
}

.fb-hint {
  font-size: 26rpx;
  color: var(--text-soft);
  line-height: 1.5;
  margin-bottom: 20rpx;
}
