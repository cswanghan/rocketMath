/* 答题界面的公共样式 —— play (口算) 与 race (竞速) 共用。
 * WXSS 是页面级作用域, 与其在两个页面各抄一遍不如 @import 同一份。 */

.play {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* ---- 顶部 ---------------------------------------------------------------- */

.play-head {
  display: flex;
  align-items: center;
}

.head-btn {
  color: var(--muted);
  font-size: 28rpx;
  padding: 8rpx 12rpx;
}

.head-xp {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--accent2);
  margin-left: 16rpx;
}

.play-status {
  display: flex;
  align-items: center;
  margin: 12rpx 0;
}

.phase-badge {
  background: var(--p-lavender-pill);
  color: var(--p-lavender-ink);
  font-size: 22rpx;
  font-weight: 700;
  padding: 4rpx 20rpx;
  border-radius: 999rpx;
  margin-right: 16rpx;
}

.prog {
  font-size: 24rpx;
  color: var(--text-soft);
}

/* ---- 关卡格 -------------------------------------------------------------- */

.chart {
  display: flex;
  flex-wrap: wrap;
  margin: 8rpx 0 16rpx;
}

.cell {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 10rpx;
  margin: 0 8rpx 8rpx 0;
  background: var(--inset);
  color: var(--muted);
}

.cell-done { background: var(--good); color: #fff; }
.cell-current { background: var(--accent2); color: #fff; }

/* ---- 主舞台 -------------------------------------------------------------- */

.stage {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.prompt {
  text-align: center;
  font-size: 96rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  margin: 20rpx 0;
}

.answer-box {
  height: 120rpx;
  line-height: 120rpx;
  text-align: center;
  font-size: 72rpx;
  font-weight: 800;
  color: var(--accent-ink);
  background: var(--inset);
  border: 2rpx solid var(--line);
  border-radius: var(--radius-sm);
  margin: 20rpx 0 28rpx;
}

/* ---- 数字键盘 ------------------------------------------------------------ */

.numpad {
  margin-top: auto;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.key {
  width: 31.5%;
  height: 108rpx;
  line-height: 108rpx;
  text-align: center;
  font-size: 42rpx;
  font-weight: 700;
  background: var(--panel);
  border: 2rpx solid var(--line);
  border-radius: var(--radius-sm);
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-soft);
}

.key--pressed {
  background: var(--active);
  transform: scale(0.96);
}

.key-fn {
  background: var(--inset);
  color: var(--text-soft);
}

.key-enter {
  background: var(--btn-grad);
  color: #fff;
  border-color: transparent;
  box-shadow: var(--btn-shadow);
}

/* ---- 浮层 ---------------------------------------------------------------- */

.big-fact {
  font-size: 56rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.big-answer {
  color: var(--good-ink);
  font-weight: 800;
}

.hint {
  color: var(--muted);
  font-size: 26rpx;
}

.celebrate {
  background: linear-gradient(135deg, #ffffff 0%, var(--p-mint) 320%);
}
