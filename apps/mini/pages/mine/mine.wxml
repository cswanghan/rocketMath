<view class="page">
  <view class="page-title">我的</view>

  <!-- 账号 -->
  <view class="pcard account-card">
    <block wx:if="{{user}}">
      <view class="row">
        <view class="account-av">{{userInitial}}</view>
        <view class="account-text">
          <view class="account-name">{{user.username || '星芽用户'}}</view>
          <view class="account-sub">进度已云端同步，换设备也能接着学</view>
        </view>
        <button class="btn btn-ghost btn-sm" bindtap="onLogout">退出</button>
      </view>
    </block>
    <block wx:else>
      <view class="account-name">还没登录</view>
      <view class="account-sub">登录后无限畅学，进度、经验值和错题本都会保存</view>
      <button class="btn btn-primary" style="margin-top:24rpx" bindtap="onLogin">微信一键登录</button>
    </block>
  </view>

  <!-- 学习者 -->
  <view class="pcard">
    <view class="section-title">谁在学习</view>
    <view class="child-grid">
      <view
        class="child-tile {{!activeChild ? 'sel' : ''}}"
        data-id=""
        bindtap="onPickChild"
        hover-class="child-tile--pressed"
      >
        <text class="child-av">👨‍👧</text>
        <text class="child-nm">家长</text>
      </view>
      <view
        class="child-tile {{activeChild.id === item.id ? 'sel' : ''}}"
        wx:for="{{children}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onPickChild"
        hover-class="child-tile--pressed"
      >
        <text class="child-av">{{item.avatar}}</text>
        <text class="child-nm">{{item.name}}</text>
        <text class="child-del" data-id="{{item.id}}" catchtap="onDeleteChild">×</text>
      </view>
    </view>

    <block wx:if="{{user}}">
      <button class="btn btn-plain btn-sm" wx:if="{{!adding}}" bindtap="onToggleAdd">＋ 添加孩子</button>
      <view class="child-add" wx:else>
        <view class="av-row">
          <text
            class="av-pick {{newAvatar === item ? 'sel' : ''}}"
            wx:for="{{avatars}}"
            wx:key="*this"
            data-avatar="{{item}}"
            bindtap="onPickAvatar"
          >{{item}}</text>
        </view>
        <input
          class="fill-input"
          placeholder="孩子的名字"
          maxlength="20"
          value="{{newName}}"
          bindinput="onNameInput"
          confirm-type="done"
          bindconfirm="onAddChild"
        />
        <button class="btn btn-primary" disabled="{{busy}}" bindtap="onAddChild">
          {{busy ? '添加中…' : '添加孩子'}}
        </button>
        <button class="btn btn-ghost" style="margin-top:16rpx" bindtap="onToggleAdd">取消</button>
      </view>
    </block>
    <view class="hint" wx:else>登录后可以给每个孩子建独立档案，进度互不干扰</view>
  </view>

  <!-- 等级 / 打卡 -->
  <view class="pcard">
    <view class="section-title">学习成果</view>
    <view class="row level-row">
      <text class="level-badge">Lv.{{level.level}}</text>
      <view class="level-text">
        <view class="level-xp">{{xp}} 经验值</view>
        <view class="level-next">再练 {{level.toNext}} 点升到 Lv.{{level.level + 1}}</view>
      </view>
    </view>
    <view class="level-bar">
      <view class="level-bar-fill" style="width:{{level.span ? level.intoLevel / level.span * 100 : 0}}%"></view>
    </view>
    <view class="stat-row" wx:if="{{streak}}">
      <view class="stat">
        <text class="stat-num">{{streak.current}}</text>
        <text class="stat-label">连续天数</text>
      </view>
      <view class="stat">
        <text class="stat-num">{{streak.longest}}</text>
        <text class="stat-label">最长记录</text>
      </view>
      <view class="stat">
        <text class="stat-num">{{streak.badges.length}}</text>
        <text class="stat-label">徽章</text>
      </view>
    </view>
  </view>

  <!-- 设置 -->
  <view class="pcard settings-card">
    <view class="setting-row" bindtap="onChangeGrade" hover-class="setting-row--pressed">
      <text class="setting-label">当前年级</text>
      <text class="setting-value">{{gradeLabel || '未选择'}}</text>
      <text class="setting-arrow">›</text>
    </view>
    <view class="setting-row" bindtap="onParent" hover-class="setting-row--pressed">
      <text class="setting-label">家长中心</text>
      <text class="setting-value">错题本 · 学情总结</text>
      <text class="setting-arrow">›</text>
    </view>
    <view class="setting-row" bindtap="onExamCal" hover-class="setting-row--pressed">
      <text class="setting-label">考试日历</text>
      <text class="setting-value">AMC · 袋鼠 · KET/PET</text>
      <text class="setting-arrow">›</text>
    </view>
    <view class="setting-row danger" bindtap="onReset" hover-class="setting-row--pressed">
      <text class="setting-label">清空学习进度</text>
      <text class="setting-arrow">›</text>
    </view>
  </view>

  <view class="footer-hint">星芽 · 学习内容随小程序离线可用</view>
</view>
