      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learning data stays on your device by default. Sync is manual. AI summaries send sample problems, responses, correct answers and timing to DeepSeek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
